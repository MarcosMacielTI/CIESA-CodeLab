# Application ports
WEB_PORT=5173
API_PORT=3001
EXECUTOR_PORT=4001

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ciesa_codelab
POSTGRES_USER=ciesa
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ciesa:change-me@localhost:5433/ciesa_codelab?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# App config
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
